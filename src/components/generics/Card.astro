---
import Github from '@icons/Github.svg'

interface Props {
  title: string
  paragraph: string
  skills: string[]
}

const { title, paragraph, skills } = Astro.props
---

<article class='flex flex-col p-6 bg-primary-400 rounded-3xl gap-3'>
  <div class='flex flex-row justify-between'>
    <slot name='icon' />
    <Github fill='currentColor' width={20} height={20} />
  </div>
  <div class='flex flex-col gap-0.5 font-inter'>
    <h3 class='text-lg font-bold text-secondary'>{title}</h3>
    <p class='text-sm text-tertiary'>{paragraph}</p>
  </div>
  <ul class='flex flex-row gap-4 font-fragment text-sm text-contrast list-none'>
    {skills.map((skill: string) => (
      <li>{skill}</li>
    ))}
  </ul>
</article>
