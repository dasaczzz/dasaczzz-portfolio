---
interface Props {
  text: string
  textSize?: string
}

const { text, textSize = 'text-lg' } = Astro.props
---

<button
  class:list={[
    'bg-transparent border border-solid border-contrast text-contrast',
    'font-fragment flex flex-row items-center justify-center',
    'rounded-md p-3 cursor-pointer',
    'transition-all duration-200 hover:bg-contrast hover:text-primary-300',
    textSize,
  ]}
>
  {text}
</button>
